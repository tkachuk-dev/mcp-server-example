APP_NAME=billing-service
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=http://billing-service
APP_TIMEZONE=UTC

# Logs are JSON to stderr; every line carries request_id / trace_id via the Context facade.
LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=info
# Stream of the ai_audit channel (one JSON line per /internal/ai request).
AI_AUDIT_LOG_STREAM=php://stderr

# Own database of the billing service (database per service).
DB_CONNECTION=pgsql
DB_HOST=billing-db
DB_PORT=5432
DB_DATABASE=billing
DB_USERNAME=billing
DB_PASSWORD=change-me

# Redis keeps cache and rate limiter state, so replicas stay stateless.
REDIS_CLIENT=phpredis
REDIS_HOST=billing-redis
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array

# JSON array of sha256 hashes of accepted MCP service tokens (several entries allow rotation).
# Placeholder below is sha256("dev-mcp-token") — local development only.
MCP_SERVICE_TOKEN_HASHES='["d967787d3023c82861961e4fb7acaacf48d1175fa1873b4b679bec86c69afd7c"]'
# Requests per minute per actor (mcp:<email>) on /internal/ai.
INTERNAL_AI_RATE_LIMIT_PER_MINUTE=120
# TTL (seconds) of cached analytics on /internal/ai.
INTERNAL_AI_CACHE_TTL=600

# Run migrations on container start (docker/entrypoint.sh).
RUN_MIGRATIONS=false
