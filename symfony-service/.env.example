# Copy to .env.local (or inject as real env vars in the cluster). Never commit real secrets.

# Symfony environment: dev | prod
APP_ENV=prod
# Random 32+ char secret used by the framework (CSRF, signed URLs)
APP_SECRET=change-me
# Users service database (database per service, PostgreSQL 17)
DATABASE_URL="postgresql://app:app@database:5432/users?serverVersion=17&charset=utf8"
# Shared Redis for cache.app and the internal_ai rate limiter (required for horizontal scaling)
REDIS_URL=redis://redis:6379
# Proxies (ingress / API gateway) whose X-Forwarded-* headers are trusted
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
# JSON array of sha256 hashes of accepted MCP service tokens (several entries = rotation).
# Placeholder below is sha256("dev-mcp-token") — local development only.
MCP_SERVICE_TOKEN_HASHES='["d967787d3023c82861961e4fb7acaacf48d1175fa1873b4b679bec86c69afd7c"]'
