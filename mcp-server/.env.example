# Copy to .env.local (local run) or set as container env. Never commit real values.

# Symfony environment: prod in containers, dev for local debugging.
APP_ENV=prod
# Random string, e.g. `openssl rand -hex 16`.
APP_SECRET=change-me

# Base URL of the Users service (internal DNS name, no /internal/ai/v1 suffix).
USERS_SERVICE_INTERNAL_API=http://users-service
# Service token issued by the Users service (its sha256 is in users-service MCP_SERVICE_TOKEN_HASHES).
USERS_SERVICE_TOKEN=dev-mcp-token
# Base URL of the Billing service (internal DNS name, no /internal/ai/v1 suffix).
BILLING_SERVICE_INTERNAL_API=http://billing-service
# Service token issued by the Billing service (its sha256 is in billing-service MCP_SERVICE_TOKEN_HASHES).
BILLING_SERVICE_TOKEN=dev-mcp-token

# OAuth client ID from Google Cloud Console; tokens with another "aud" are rejected.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
# Only verified emails of this Google Workspace domain may use the server.
ALLOWED_EMAIL_DOMAIN=example.com
# Public URL of the MCP endpoint, used as "resource" in the OAuth protected resource metadata.
MCP_PUBLIC_URL=http://localhost:8080/mcp
# Comma-separated Origin allowlist (DNS rebinding protection); requests without Origin are not affected.
MCP_ALLOWED_ORIGINS=https://claude.ai,https://claude.com,http://localhost:6274
