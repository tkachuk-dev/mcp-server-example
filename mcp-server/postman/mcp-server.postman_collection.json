    {
      "name": "MCP",
      "description": "JSON-RPC 2.0 over POST {{mcp_path}}. Run in order: initialize → notifications/initialized → tools/list → tools/call. Needs a Google access token (collection auth).",
      "item": [
        {
          "name": "initialize",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The bundle answers JSON; SSE (event: message / data: ...) only when the server itself asks the client something.",
                  "function mcpMessage() {",
                  "    const type = pm.response.headers.get('Content-Type') || '';",
                  "    if (!type.includes('text/event-stream')) { return pm.response.json(); }",
                  "    const data = pm.response.text().split('\\n').filter(l => l.startsWith('data:')).map(l => l.slice(5).trim());",
                  "    return JSON.parse(data[data.length - 1]);",
                  "}",
                  "pm.test('200 JSON', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });",
                  "const sessionId = pm.response.headers.get('Mcp-Session-Id');",
                  "pm.test('Mcp-Session-Id returned', () => pm.expect(sessionId).to.be.a('string').and.not.empty);",
                  "pm.environment.set('mcp_session_id', sessionId);",
                  "const msg = mcpMessage();",
                  "pm.test('protocol negotiated', () => pm.expect(msg.result.protocolVersion).to.eql(pm.environment.get('mcp_protocol_version')));",
                  "pm.test('server info', () => pm.expect(msg.result.serverInfo).to.have.property('name'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
