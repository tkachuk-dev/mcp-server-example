              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The bundle answers JSON; SSE (event: message / data: ...) only when the server itself asks the client something.",
                  "function mcpMessage() {",
                  "    const type = pm.response.headers.get('Content-Type') || '';",
                  "    if (!type.includes('text/event-stream')) { return pm.response.json(); }",
                  "    const data = pm.response.text().split('\\n').filter(l => l.startsWith('data:')).map(l => l.slice(5).trim());",
                  "    return JSON.parse(data[data.length - 1]);",
                  "}",
                  "const PII_KEYS = ['email', 'phone', 'name', 'first_name', 'last_name', 'firstname', 'lastname', 'address', 'ip', 'user_agent', 'useragent', 'card', 'iban', 'token', 'password'];",
                  "function assertNoPii(value) {",
                  "    if (Array.isArray(value)) { value.forEach(assertNoPii); return; }",
                  "    if (value && typeof value === 'object') {",
                  "        Object.keys(value).forEach(k => { pm.expect(PII_KEYS, 'PII key: ' + k).to.not.include(k.toLowerCase()); assertNoPii(value[k]); });",
                  "    }",
                  "}",
                  "pm.test('200 JSON', () => { pm.response.to.have.status(200); pm.response.to.be.json; });",
                  "const result = mcpMessage().result;",
                  "pm.test('not an error', () => pm.expect(result.isError || false).to.eql(false));",
                  "pm.test('key fields present', () => pm.expect(result.structuredContent).to.include.keys([\"tenant_id\", \"total_users\", \"active_last_30_days\", \"blocked_users\", \"two_factor_enabled_ratio\", \"roles\"]));",
                  "pm.test('no PII keys', () => assertNoPii(result.structuredContent));"
                ]
              }
